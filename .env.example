# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
# Use "*" only for local testing — set this to your real Vercel frontend URL in production.
# Example: CORS_ORIGIN="https://your-frontend.vercel.app,http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# GEMINI_API_KEY: Required for AI resume analysis via Google Gemini.
GEMINI_API_KEY="your_gemini_api_key"

# MySQL Database Configuration (optional).
# If provided, analysis metadata is persisted to MySQL via Sequelize.
# If omitted, the API runs in a lightweight in-memory mode (data is lost on restart/cold start).
DB_HOST=""
DB_PORT=3306
DB_NAME="airesumeanalyser"
DB_USER=""
DB_PASSWORD=""
